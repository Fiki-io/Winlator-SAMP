<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorPrimarySurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Banner / Player Profile Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/colorSecondarySurface"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/TVPlayerNickname"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Player_Android"
                    android:textColor="?attr/colorPrimaryText"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/TVGtaStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GTA SA: Checking..."
                    android:textColor="?attr/colorSecondaryText"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/BTAddServer"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="+ Add IP"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:background="?attr/colorAccent"
                android:paddingHorizontal="12dp" />
        </LinearLayout>

        <!-- Tab Selector (Favorites / Hosted) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="?attr/colorPrimarySurface"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp">

            <Button
                android:id="@+id/BTTabFavorites"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="★ Favorites"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="?attr/colorPrimaryVariant"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/BTTabHosted"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🌐 Hosted"
                android:textSize="13sp"
                android:textColor="?attr/colorSecondaryText"
                android:background="?attr/colorSecondarySurface"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Server RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/RVServers"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingVertical="4dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/TVEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="No servers added yet.\nClick + Add IP to add a server."
        android:textColor="?attr/colorSecondaryText"
        android:gravity="center"
        android:visibility="gone" />
</FrameLayout>
